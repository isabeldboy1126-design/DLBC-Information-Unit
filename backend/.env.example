# Environment variables for the DLBC Information Unit App backend.
# Copy this file to .env and fill in the required values.
# NEVER commit the .env file to version control.

# --- Application ---
APP_ENV=development
APP_DEBUG=true
# Set ENABLE_LOCAL_DEMO=true ONLY in local development to enable developer demo mode.
# In production environments (e.g. Azure), leave unset or false.
ENABLE_LOCAL_DEMO=true

# --- Database ---
DATABASE_URL=sqlite+aiosqlite:///./storage/app.db

# --- AI Providers & Transcription ---
# 1. Azure Speech-to-Text
# AZURE_SPEECH_KEY=your_azure_speech_key_here
# AZURE_SPEECH_REGION=southafricanorth
# AZURE_SPEECH_LANGUAGE=en-NG

# 2. Google Cloud Speech-to-Text
# Option A (Recommended): Path to service account JSON key file
# GOOGLE_APPLICATION_CREDENTIALS=C:\path\to\service-account-key.json
# Option B: API Key (for direct REST speech recognize)
# GOOGLE_SPEECH_API_KEY=
# Required for long/sermon-length audio batch transcription (> 1 minute):
# GCS_BUCKET_NAME=your-gcs-bucket-name

# 3. Local Faster-Whisper (No API keys required)
# WHISPER_MODEL_SIZE=small
# WHISPER_DEVICE=cpu
# WHISPER_COMPUTE_TYPE=int8

# --- Storage ---
STORAGE_PATH=../storage


