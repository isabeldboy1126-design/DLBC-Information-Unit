# Frontend Environment Variables (for Vercel or local override)
# In local development, these are optional and default to localhost:8000.

# Base HTTPS URL for the backend API (set to your public Cloudflare Tunnel URL when deploying)
# Example: VITE_API_BASE_URL=https://dlbc-api.trycloudflare.com
VITE_API_BASE_URL=http://localhost:8000

# Base WebSocket URL (optional: automatically derived from VITE_API_BASE_URL if omitted)
# Example: VITE_WS_BASE_URL=wss://dlbc-api.trycloudflare.com
